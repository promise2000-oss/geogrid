# GeoGrid — environment key names only. NEVER commit real values.
# Real values live in the hosting platform's secret manager (e.g., Lovable Cloud -> Secrets).

# --- Frontend (exposed to the browser; never place secrets here) ---
# Admin console route slug. Resolved at build time. The default below is a
# placeholder — set a non-guessable value before launch and never let the real
# path appear in docs, tickets, or chat transcripts.
VITE_ADMIN_ROUTE_SLUG=system-console

# --- Backend (server-side only; not used by the frontend slice) ---
# Supabase (service role key must NEVER ship to the browser — Edge Functions only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Super Admin provisioning — consumed once by supabase/seed/seed-admins.ts,
# never persisted, logged, or displayed. Rotate any credential ever typed
# into a chat, ticket, doc, or prompt — treat it as already compromised.
SUPERADMIN_1_EMAIL=
SUPERADMIN_1_PASSWORD=
SUPERADMIN_2_EMAIL=
SUPERADMIN_2_PASSWORD=
SUPERADMIN_3_EMAIL=
SUPERADMIN_3_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business Platform (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Email provider
RESEND_API_KEY=